{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/MarcoPorcellato/matryca-plumber/blob/main/docs/quality/ccp-savings/schema-v1.json",
  "additionalProperties": false,
  "description": "Closed schema for immutable hybrid-CI savings observations. Semantic cross-field rules are enforced by scripts/ccp_savings_report.py.",
  "properties": {
    "billing_source": {"type": ["object", "null"]},
    "candidate_hosted_seconds": {"maximum": 86400, "minimum": 0, "type": ["integer", "null"]},
    "captured_at": {"format": "date-time", "type": "string"},
    "ccp": {"type": ["object", "null"]},
    "classification": {"enum": ["observed_baseline", "eligible", "fallback", "negative", "failed", "cancelled", "excluded"]},
    "comparability": {"enum": ["pass", "fail", "not_applicable"]},
    "eligibility_reason": {"minLength": 1, "type": "string"},
    "estimated_avoided_hosted_seconds": {"maximum": 86400, "minimum": 0, "type": ["integer", "null"]},
    "estimated_net_hosted_seconds_saved": {"maximum": 86400, "minimum": 0, "type": ["integer", "null"]},
    "fallback_reason": {"type": ["string", "null"]},
    "limitations": {"items": {"minLength": 1, "type": "string"}, "minItems": 1, "type": "array"},
    "negative_case": {"enum": ["missing", "stale", "corrupt", "wrong_sha", null]},
    "observed_verifier_seconds": {"maximum": 86400, "minimum": 0, "type": ["integer", "null"]},
    "pr_number": {"minimum": 1, "type": ["integer", "null"]},
    "provider_confirmed_billed_minutes": {"minimum": 0, "type": ["number", "null"]},
    "provider_confirmed_cost": {"minimum": 0, "type": ["number", "null"]},
    "record_id": {"pattern": "^[a-z0-9][a-z0-9._-]{2,127}$", "type": "string"},
    "repository": {"const": "MarcoPorcellato/matryca-plumber"},
    "schema_version": {"const": "1.0"},
    "source_sha": {"pattern": "^[0-9a-f]{40}$", "type": "string"},
    "source_urls": {"items": {"format": "uri", "type": "string"}, "minItems": 1, "type": "array"},
    "supersedes": {"type": ["string", "null"]},
    "verifier": {"type": ["object", "null"]},
    "workflow_runs": {"items": {"type": "object"}, "minItems": 1, "type": "array"}
  },
  "required": [
    "schema_version", "record_id", "classification", "captured_at", "supersedes",
    "repository", "pr_number", "source_sha", "eligibility_reason", "comparability",
    "workflow_runs", "ccp", "verifier", "fallback_reason", "negative_case",
    "candidate_hosted_seconds", "estimated_avoided_hosted_seconds",
    "observed_verifier_seconds", "estimated_net_hosted_seconds_saved",
    "provider_confirmed_billed_minutes", "provider_confirmed_cost", "billing_source",
    "limitations", "source_urls"
  ],
  "title": "Matryca Plumber CCP savings observation v1",
  "type": "object"
}
